# PostgreSQL database settings

# Database name
DATABASE_NAME=

# Database user
DATABASE_USERNAME=

# Database password
DATABASE_PASSWORD=

# Database host
DATABASE_HOST=

# Database port
DATABASE_PORT=


# JWT / Security

# Secret key for signing JWT tokens
# Generate with:
# openssl rand -hex 32
SECRET_KEY=

# JWT signing algorithm
ALGORITHM=HS256

# Access token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_TIME=30